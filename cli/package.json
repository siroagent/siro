{
  "name": "siroagent",
  "version": "0.1.3",
  "description": "Siro for agents: an encrypted local wallet that pays x402 resources, discovers and pays third-party x402 services (USDG on Robinhood Chain; USDC on Solana, Base, Arbitrum, Polygon), and swaps on Robinhood Chain and Base. CLI, SDK and MCP server.",
  "type": "module",
  "bin": {
    "siro": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/cli/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/cli/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "pack:site": "node build.mjs && npm pack --pack-destination ../public/cli"
  },
  "keywords": [
    "x402",
    "agents",
    "mcp",
    "wallet",
    "robinhood-chain",
    "base",
    "arbitrum",
    "polygon",
    "solana",
    "usdg",
    "usdc"
  ],
  "homepage": "https://siroagent.com/docs#cli",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "viem": "^2.58.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siroagent/siro.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/siroagent/siro/issues"
  }
}
