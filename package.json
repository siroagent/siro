{
  "name": "siro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply siro --local",
    "db:migrate:remote": "wrangler d1 migrations apply siro --remote",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types worker/env.d.ts --env-interface Env",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "hono": "^4.13.21",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  },
  "description": "Pay-per-call tools for AI agents over x402: every tool quotes its price first, the agent pays from a capped budget, and the payment settles only when a result comes back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siroagent/siro.git"
  },
  "homepage": "https://siroagent.com",
  "engines": {
    "node": ">=20"
  }
}
